{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@TimeTable/*": ["apps/time-table/src/*"],
      "@libs/shared/shadcn-ui/ui/*": ["libs/shared/shadcn-ui/ui/src/*"],
      "@libs/shared/shadcn-ui/util/*": ["libs/shared/shadcn-ui/util/src/*"],
      "@libs/shared/utils/*": ["libs/shared/utils/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
